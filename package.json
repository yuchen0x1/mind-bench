  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },

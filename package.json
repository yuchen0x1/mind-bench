{
  "name": "mind-bench",
  "version": "0.2.0",
  "private": true,
  "description": "MIND BENCH — AI Intelligence Testing Arena",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node src/server.mjs",
    "build": "vite build",
    "start": "node src/server.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
